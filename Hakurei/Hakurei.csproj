<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.10.5" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.10.5" />
    <PackageReference Include="SDL3-CS.Windows.Image" Version="3.4.4.5" />
    <PackageReference Include="SDL3-CS.Windows.Mixer" Version="3.2.4.5" />
    <PackageReference Include="SDL3-CS.Windows.Shadercross" Version="3.0.0.5" />
    <PackageReference Include="SDL3-CS.Windows.TTF" Version="3.2.2.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\cat.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Engine\Shaders\2D.frag.hlsl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Engine\Shaders\2D.vert.hlsl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Engine\Shaders\Default.frag.hlsl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Engine\Shaders\Default.vert.hlsl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
